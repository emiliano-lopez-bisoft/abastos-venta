# Copia este archivo como .env y completa los valores. El .env NO se sube al repositorio.
# La cadena de conexión la obtienes del panel de tu proveedor (Neon, Supabase, etc.).
DATABASE_URL="postgresql://<usuario>:<contraseña>@<host>:5432/abastos?sslmode=require"
PORT=3000
CORS_ORIGIN="http://localhost:4200"
